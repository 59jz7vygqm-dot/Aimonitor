# ---------------------------------------------------------------- Pflicht
# Starkes Passwort für PostgreSQL. Sonderzeichen sind erlaubt – der Server
# kodiert es selbst, es wird nirgends in eine URL geklebt:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Bootstrap-Token mit Scope admin+ingest+read. Damit richtet man die
# eigentlichen Agent-Tokens ein:
#   openssl rand -hex 32
AIMON_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------- Zugriff
# Leer = die Lese-API und das Dashboard sind offen. Dann gehört aimonitor
# hinter einen Reverse-Proxy mit Authentifizierung. Gesetzt = jeder
# Lesezugriff braucht dieses Token (im Dashboard oben rechts eintragen).
AIMON_READ_TOKEN=

# Worauf der Server lauscht. 127.0.0.1 wenn ein Reverse-Proxy davor steht.
AIMON_BIND=0.0.0.0
AIMON_PORT=8420

# ------------------------------------------------------------- Datenschutz
# true lässt den Privacy-Proxy ungefilterte Suchanfragen mitschicken, die
# dann im Dashboard sichtbar sind. Default false ist bewusst: sonst sammelt
# das Monitoring genau die Daten ein, die der Proxy entfernen soll.
AIMON_ALLOW_RAW_QUERIES=false
AIMON_RAW_QUERY_RETENTION_DAYS=2

# ------------------------------------------------------------- Aufbewahrung
AIMON_RAW_RETENTION_DAYS=14
AIMON_ROLLUP_1M_DAYS=90
AIMON_ROLLUP_1H_DAYS=730
AIMON_REQUESTS_RETENTION_DAYS=30
AIMON_EVENTS_RETENTION_DAYS=180

# --------------------------------------------------------------- Schwellen
AIMON_STALE_AFTER_S=90
AIMON_GPU_TEMP_WARN_C=83
AIMON_GPU_TEMP_CRIT_C=88
AIMON_TTFT_WARN_MS=2000
AIMON_TTFT_CRIT_MS=8000
AIMON_HEADROOM_WARN_PCT=20
AIMON_BLOCK_RATE_WARN_PCT=25
# Unterhalb so vieler Anfragen ist eine Blockquote keine Aussage:
# bei drei Suchen sind 33 % eine einzige geblockte.
AIMON_BLOCK_RATE_MIN_REQUESTS=50

# Pro Token und Minute. Ein Agent mit 10-s-Intervall braucht ~6/min;
# bei vielen Servern an einem Token entsprechend erhöhen.
AIMON_RATE_LIMIT_PER_MIN=600

# ------------------------------------------------------------- Benachrichtigung
#
# Standardmäßig aus. Eingeschaltet wird nur bei Incidents ab der
# Mindestschwere benachrichtigt, die länger als min_duration bestehen, und
# höchstens einmal je Incident plus einer Entwarnung.
#
# Hintergrund: eine Benachrichtigung, die zu oft kommt, wird weggefiltert –
# und fehlt dann an dem Tag, an dem sie wichtig gewesen wäre. Deshalb lieber
# zu selten als zu oft. Mit 'warning' statt 'critical' bekommst du bei einem
# normalen Stack mehrere Meldungen pro Tag; das ist selten gewollt.
AIMON_ALERT_MIN_SEVERITY=critical
AIMON_ALERT_MIN_DURATION_S=300
AIMON_ALERT_SEND_RESOLVED=true
AIMON_ALERT_MAX_PER_HOUR=10

# Für die Links in der Nachricht.
AIMON_PUBLIC_URL=

# --- Variante A: Webhook (empfohlen)
# Funktioniert mit ntfy, Gotify, Discord, Slack, Home Assistant …
# Kein SMTP-Passwort nötig, kommt direkt aufs Handy.
#   ntfy:    https://ntfy.sh/dein-geheimes-topic
#   Discord: https://discord.com/api/webhooks/...
AIMON_ALERT_WEBHOOK_URL=
# Zusätzliche Header als JSON, z. B. {"Authorization":"Bearer ..."}
AIMON_ALERT_WEBHOOK_HEADERS=

# --- Variante B: E-Mail
AIMON_ALERT_SMTP_HOST=
AIMON_ALERT_SMTP_PORT=587
AIMON_ALERT_SMTP_USER=
AIMON_ALERT_SMTP_PASSWORD=
# starttls | ssl | none
AIMON_ALERT_SMTP_TLS=starttls
AIMON_ALERT_MAIL_FROM=
# Mehrere Empfänger mit Komma trennen.
AIMON_ALERT_MAIL_TO=

# ------------------------------------------------------------------- Sonstiges
TZ=Europe/Berlin
AIMON_VERSION=0.1.0

# Ohne TimescaleDB-Extension:
# AIMON_DB_IMAGE=postgres:16-alpine
AIMON_DB_IMAGE=timescale/timescaledb:2.17.2-pg16

# PostgreSQL-Tuning. shared_buffers auf ~25 % des RAM des DB-Hosts.
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=60

# DB-Port nach außen. Default nur lokal.
AIMON_DB_PORT=127.0.0.1:5432
